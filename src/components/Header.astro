---
// Header — sticky glassmorphism nav
---

<header
  class="fixed top-0 left-0 right-0 h-[84px] z-[1000] transition-all duration-500 bg-[rgba(8,9,11,0.7)] backdrop-blur-[18px] border-b border-[rgba(212,175,55,0.08)]"
  id="header"
>
  <div class="max-w-[1280px] mx-auto px-[clamp(1.5rem,5vw,3.5rem)] h-full flex items-center justify-between relative z-10">

    <!-- Logo -->
    <a href="#hero" class="flex items-center gap-3 group" aria-label="Cheniza Kate Home">
      <div class="w-9 h-9 rounded-full border border-gold-primary flex items-center justify-center font-poppins font-semibold text-[1.05rem] text-gold-primary bg-[rgba(212,175,55,0.08)] shadow-[0_0_15px_rgba(212,175,55,0.22)] transition-transform duration-500 group-hover:rotate-[360deg]">
        CK
      </div>
      <span class="font-poppins text-[1.3rem] font-semibold tracking-wide text-text-primary">
        Cheniza Kate
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-10" aria-label="Main Navigation">
      {['About', 'Services & Estimator', 'Selected Work', 'Client Praise', 'Contact'].map((label, i) => {
        const hrefs = ['#about', '#services', '#work', '#testimonials', '#contact'];
        return (
          <a
            href={hrefs[i]}
            class="text-[0.85rem] font-semibold tracking-[0.06em] text-text-secondary hover:text-gold-bright transition-colors duration-200 relative py-1.5 nav-link"
          >
            {label}
          </a>
        );
      })}
    </nav>

    <!-- CTA -->
    <div class="hidden md:flex items-center gap-6">
      <a href="#contact" class="btn-gold text-[0.8rem] font-bold tracking-[0.14em] uppercase px-8 py-4 rounded-[4px]">
        Book a Strategy Call
      </a>
    </div>

    <!-- Mobile Hamburger -->
    <button
      class="md:hidden flex flex-col justify-center gap-[6px] w-10 h-10 p-2 z-[1001]"
      id="mobileToggle"
      aria-label="Toggle Navigation"
    >
      <span class="block w-full h-[2px] bg-gold-primary transition-all duration-300 origin-center"></span>
      <span class="block w-full h-[2px] bg-gold-primary transition-all duration-300 origin-center"></span>
      <span class="block w-full h-[2px] bg-gold-primary transition-all duration-300 origin-center"></span>
    </button>
  </div>
</header>

<style>
  .btn-gold {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: linear-gradient(135deg, #F3E5AB 0%, #D4AF37 50%, #A8821F 100%);
    color: #08090B;
    box-shadow: 0 4px 25px rgba(212, 175, 55, 0.22);
    border: 1px solid #FFF2C2;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .btn-gold::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #FFF2C2 0%, #F4D068 100%);
    opacity: 0;
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: -1;
  }
  .btn-gold:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 35px rgba(212, 175, 55, 0.45);
    color: #08090B;
  }
  .btn-gold:hover::before { opacity: 1; }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(135deg, #F3E5AB 0%, #D4AF37 50%, #A8821F 100%);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .nav-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  #header.is-scrolled {
    background: rgba(8, 9, 11, 0.92);
    border-bottom-color: rgba(212, 175, 55, 0.35);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }
</style>

<script>
  const header = document.getElementById('header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) header?.classList.add('is-scrolled');
    else header?.classList.remove('is-scrolled');
  }, { passive: true });
</script>
