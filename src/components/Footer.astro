---
// Footer
---

<footer class="border-t border-[rgba(212,175,55,0.12)] bg-[#08090B] py-10">
  <div class="max-w-[1280px] mx-auto px-[clamp(1.5rem,5vw,3.5rem)]">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6 mb-8">
      <div>
        <span class="font-poppins text-[1.4rem] font-semibold text-gold-light">Cheniza Kate</span>
        <p class="font-ibm text-[0.8rem] text-text-muted mt-1">Social. Styled. Strategic.</p>
      </div>

      <div class="flex items-center gap-3">
        <a href="#" class="footer-social" aria-label="Instagram">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
        </a>
        <a href="#" class="footer-social" aria-label="LinkedIn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>
          </svg>
        </a>
        <a href="mailto:caballerokeith2@gmail.com" class="footer-social" aria-label="Email">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
          </svg>
        </a>
      </div>
    </div>

    <div class="gold-divider mb-8" />

    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-[0.78rem] font-ibm text-text-muted">
      <p>© 2026 Cheniza Kate. All rights reserved.</p>
      <p>Crafted with bespoke luxury & precision <span class="text-gold-primary">✦</span></p>
    </div>
  </div>
</footer>

<style>
  .footer-social {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid rgba(212, 175, 55, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #A3A8B5;
    transition: all 0.3s ease;
  }
  .footer-social:hover {
    border-color: #D4AF37;
    color: #F4D068;
    background: rgba(212, 175, 55, 0.08);
    transform: translateY(-2px);
  }
</style>
