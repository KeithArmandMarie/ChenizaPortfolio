---
// Mobile Nav — fullscreen overlay drawer
---

<div
  class="fixed inset-0 z-[999] bg-[rgba(255,255,255,0.98)] backdrop-blur-[25px] flex flex-col justify-center items-center gap-8 -translate-y-full opacity-0 pointer-events-none transition-all duration-500"
  id="mobileNav"
  style="transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);"
>
  <nav class="flex flex-col items-center gap-6">
    {[
      ['About', '#about'],
      ['Services', '#services'],
      ['Work', '#work'],
      ['Praise', '#testimonials'],
      ['Contact', '#contact'],
    ].map(([label, href]) => (
      <a href={href} class="mobile-nav-link" data-mobile-link>{label}</a>
    ))}
  </nav>
  <a
    href="#contact"
    class="mt-4 btn-gold-mobile font-poppins text-[0.8rem] font-bold tracking-[0.14em] uppercase px-8 py-4 rounded-[6px]"
    data-mobile-link
  >
    Start Your Project ✦
  </a>
</div>

<style>
  #mobileNav.is-open {
    transform: translateY(0);
    opacity: 1;
    pointer-events: all;
  }

  .btn-gold-mobile {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #F8C8DC 0%, #D4AF37 50%, #C5A059 100%);
    color: #1F1A24;
    box-shadow: 0 4px 20px rgba(248, 200, 220, 0.4), 0 2px 10px rgba(212, 175, 55, 0.2);
    border: 1px solid rgba(248, 200, 220, 0.8);
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .btn-gold-mobile:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(248, 200, 220, 0.6);
  }
</style>

<script>
  const mobileToggle = document.getElementById('mobileToggle');
  const mobileNav = document.getElementById('mobileNav');
  const mobileLinks = document.querySelectorAll('[data-mobile-link]');
  const toggleSpans = mobileToggle?.querySelectorAll('span');

  function openNav() {
    mobileNav?.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    if (toggleSpans) {
      toggleSpans[0].style.transform = 'translateY(8px) rotate(45deg)';
      toggleSpans[1].style.opacity = '0';
      toggleSpans[2].style.transform = 'translateY(-8px) rotate(-45deg)';
    }
  }

  function closeNav() {
    mobileNav?.classList.remove('is-open');
    document.body.style.overflow = '';
    if (toggleSpans) {
      toggleSpans[0].style.transform = '';
      toggleSpans[1].style.opacity = '';
      toggleSpans[2].style.transform = '';
    }
  }

  mobileToggle?.addEventListener('click', () => {
    if (mobileNav?.classList.contains('is-open')) closeNav();
    else openNav();
  });

  mobileLinks.forEach(link => link.addEventListener('click', closeNav));
</script>
